{
  "manifest_version": 3,
  "name": "Alurtra",
  "version": "1.0",
  "description": "Alurtra — Real-time phishing & scam protection for Canadians",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://mail.google.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://mail.yahoo.com/*",
    "https://phishing-url-detector-je19.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Alurtra"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*"
      ],
      "js": [
        "content-google.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://mail.yahoo.com/*"
      ],
      "js": [
        "content-gmail.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-intercept.js"
      ],
      "run_at": "document_start",
      "exclude_matches": [
        "https://phishing-url-detector-je19.onrender.com/*",
        "https://mail.google.com/*",
        "https://www.google.com/*",
        "https://outlook.live.com/*",
        "https://mail.yahoo.com/*"
      ]
    }
  ]
}